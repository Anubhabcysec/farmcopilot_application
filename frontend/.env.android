# Used only for Android test builds: `npm run build:android`
# (regular `npm run dev` / `npm run build` for the website do NOT read this file).
#
# "localhost" on an Android device/emulator means the device itself, not your
# dev machine, so the backend URL has to be explicit here.
#
# - Android emulator -> your computer:      keep 10.0.2.2 (the emulator's
#                                            fixed alias for the host machine)
# - Physical Android phone -> your computer: replace with your computer's LAN
#                                            IP, e.g. http://192.168.1.50:5005
#                                            (find it with `ipconfig` on
#                                            Windows or `ifconfig`/`ip addr`
#                                            on Mac/Linux). Phone and computer
#                                            must be on the same Wi-Fi.
VITE_API_URL=http://10.0.2.2:5005
